rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == 'ishitasemwal84@gmail.com' ||
          request.auth.token.email.toLowerCase() == 'ishitasemwal84@gmail.com' ||
          request.auth.token.email.matches('(?i)^ishitasemwal84@gmail\\.com$')
        );
    }

    match /customers/{userId} {
      allow create, read, update: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow delete: if false;
    }

    match /products/{productId} {
      // Anyone can read product stock for customer UI badges
      allow read: if true;

      // Admin has full control over creating and modifying product stock/metadata
      allow create: if isAdmin() || (
        // Allow creating initial product document during customer checkout if valid stock payload
        request.resource.data.keys().hasAll(['productId', 'stock'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
      );
      allow update: if isAdmin() || (
        // Customers during checkout transactions can only decrement stock count
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
      );

      allow delete: if false;
    }

    match /orders/{orderId} {

      allow create: if
        request.resource.data.keys().hasAll([
          'orderNumber',
          'customer',
          'items',
          'subtotal',
          'shipping',
          'total',
          'totalWeight',
          'shippingService',
          'paymentMethod',
          'paymentScreenshot',
          'orderStatus',
          'paymentStatus',
          'statusMessage',
          'statusHistory',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.orderNumber is string
        && request.resource.data.customer is map
        && request.resource.data.items is list
        && request.resource.data.subtotal is number
        && request.resource.data.shipping is number
        && request.resource.data.total is number
        && request.resource.data.totalWeight is number
        && request.resource.data.shippingService is string
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.shipping
        && request.resource.data.orderStatus == 'Order Received'
        && request.resource.data.paymentStatus == 'Payment Pending'
        && request.resource.data.paymentMethod == 'UPI'
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time)
        && (request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt == request.time)
        && (!('userId' in request.resource.data) || (request.auth != null && request.resource.data.userId == request.auth.uid));

      // Separate get and list rules for orders
      allow get: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();

      // Only authenticated administrators can update orders.
      allow update: if isAdmin();

      // Orders must never be deleted from the client.
      allow delete: if false;
    }
  }
}
