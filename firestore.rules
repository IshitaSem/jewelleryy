rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {

      // Customers can create orders only.
      // Validate the basic structure and prevent clients
      // from assigning privileged/admin fields.
      allow create: if
        request.resource.data.keys().hasOnly([
          'orderNumber',
          'customer',
          'items',
          'subtotal',
          'total',
          'paymentMethod',
          'paymentScreenshot',
          'status',
          'createdAt'
        ])
        && request.resource.data.orderNumber is string
        && request.resource.data.customer is map
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'UPI'
        && request.resource.data.createdAt == request.time;

      // Only authenticated administrators can read orders.
      allow read: if isAdmin();

      // Only authenticated administrators can update orders.
      allow update: if isAdmin();

      // Orders must never be deleted from the client.
      allow delete: if false;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ishitasemwal84@gmail.com';
    }
  }
}
